# Copy to .env for local development. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://civicvoice:civicvoice@localhost:5432/civicvoice

# Redis
REDIS_URL=redis://localhost:6379/0

# Session cookies (generate a long random string for local use)
SESSION_SECRET=change-me-local-dev-only

# AI provider — leave empty to use document-only fallback (no fake summaries)
CIVICVOICE_LLM_API_KEY=
CIVICVOICE_LLM_BASE_URL=
CIVICVOICE_LLM_MODEL=

# Vector embeddings (requires: pip install sentence-transformers)
EMBEDDINGS_ENABLED=false

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5001

# Frontend (Next.js) — public URL of the local API
NEXT_PUBLIC_API_URL=http://localhost:5001
